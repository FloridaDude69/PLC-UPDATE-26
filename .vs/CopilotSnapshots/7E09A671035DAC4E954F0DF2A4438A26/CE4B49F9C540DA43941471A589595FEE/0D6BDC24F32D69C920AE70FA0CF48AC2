@page "/file-updates"
@using Models
@using Services
@inject IFileRepository Repository
@inject IFileUpdateManager UpdateManager
@inject IFileTimestampComparer Comparer
@inject ILogger<FileUpdates> Logger

<PageTitle>PLC Update Manager</PageTitle>

<style>
    .dashboard-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .dashboard-header h1 {
        margin: 0;
        font-size: 36px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .dashboard-header p {
        margin: 8px 0 0 0;
        font-size: 16px;
        opacity: 0.95;
    }

    .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border-left: 4px solid #667eea;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }

    .stat-card.success {
        border-left-color: #26b050;
    }

    .stat-card.warning {
        border-left-color: #ffc107;
    }

    .stat-card.info {
        border-left-color: #0099ff;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 700;
        color: #333;
        margin: 0;
    }

    .stat-label {
        font-size: 13px;
        color: #777;
        margin-top: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .tab-container {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .tab-buttons {
        display: flex;
        border-bottom: 2px solid #f0f0f0;
        background: #fafafa;
        overflow-x: auto;
    }

    .tab-button {
        flex: 1;
        padding: 16px 20px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        color: #666;
        transition: all 0.3s ease;
        position: relative;
        min-width: 150px;
    }

    .tab-button:hover {
        color: #667eea;
        background: rgba(102, 126, 234, 0.05);
    }

    .tab-button.active {
        color: #667eea;
        font-weight: 600;
    }

    .tab-button.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #667eea, #764ba2);
    }

    .tab-content {
        padding: 30px;
        display: none;
    }

    .tab-content.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 6px;
        font-size: 14px;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

    .form-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    .btn-secondary {
        background: #f0f0f0;
        color: #333;
    }

    .btn-secondary:hover:not(:disabled) {
        background: #e0e0e0;
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .file-list {
        background: #fafafa;
        border-radius: 6px;
        padding: 15px;
        margin-top: 15px;
        max-height: 300px;
        overflow-y: auto;
    }

    .file-item {
        background: white;
        padding: 12px 15px;
        border-radius: 4px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-left: 3px solid #667eea;
    }

    .file-item-name {
        font-weight: 500;
        color: #333;
    }

    .file-item-remove {
        background: #ff6b6b;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 12px;
        transition: all 0.3s ease;
    }

    .file-item-remove:hover {
        background: #e63946;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    .data-table thead {
        background: #f0f0f0;
    }

    .data-table th {
        padding: 15px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e0e0e0;
    }

    .data-table td {
        padding: 15px;
        border-bottom: 1px solid #f0f0f0;
        color: #666;
        font-size: 13px;
    }

    .data-table tbody tr:hover {
        background: #fafafa;
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-success {
        background: rgba(38, 176, 80, 0.15);
        color: #26b050;
    }

    .badge-info {
        background: rgba(0, 153, 255, 0.15);
        color: #0099ff;
    }

    .badge-warning {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
    }

    .badge-error {
        background: rgba(255, 107, 107, 0.15);
        color: #ff6b6b;
    }

    .alert {
        padding: 15px 20px;
        border-radius: 6px;
        margin-top: 15px;
        border-left: 4px solid;
    }

    .alert-success {
        background: rgba(38, 176, 80, 0.1);
        border-left-color: #26b050;
        color: #26b050;
    }

    .alert-error {
        background: rgba(255, 107, 107, 0.1);
        border-left-color: #ff6b6b;
        color: #ff6b6b;
    }

    .alert-info {
        background: rgba(0, 153, 255, 0.1);
        border-left-color: #0099ff;
        color: #0099ff;
    }

    .progress-bar {
        width: 100%;
        height: 8px;
        background: #e0e0e0;
        border-radius: 4px;
        overflow: hidden;
        margin-top: 10px;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea, #764ba2);
        transition: width 0.3s ease;
    }

    .loading {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(102, 126, 234, 0.3);
        border-radius: 50%;
        border-top-color: #667eea;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .container-main {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #999;
    }

    .empty-state-icon {
        font-size: 48px;
        margin-bottom: 16px;
    }

    .button-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .success-checkmark {
        color: #26b050;
        font-weight: bold;
        margin-right: 8px;
    }
</style>

<div class="container-main">
    <div class="dashboard-header">
        <h1>📊 PLC Update Manager</h1>
        <p>Professional file timestamp management for distributed systems</p>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-container">
        <div class="stat-card success">
            <p class="stat-number">@allTimestamps?.Count ?? 0</p>
            <p class="stat-label">Total Files Tracked</p>
        </div>
        <div class="stat-card info">
            <p class="stat-number">@(allTimestamps?.GroupBy(t => t.HostName).Count() ?? 0)</p>
            <p class="stat-label">Connected Hosts</p>
        </div>
        <div class="stat-card warning">
            <p class="stat-number">@(distributionUpdates?.Count ?? 0)</p>
            <p class="stat-label">Pending Updates</p>
        </div>
    </div>

    <!-- Tab Interface -->
    <div class="tab-container">
        <div class="tab-buttons">
            <button class="tab-button @(activeTab == "sync" ? "active" : "")" @onclick="() => SelectTab("sync")">
                ⬆️ Sync Files
            </button>
            <button class="tab-button @(activeTab == "repository" ? "active" : "")" @onclick="() => SelectTab("repository")">
                📁 Repository
            </button>
            <button class="tab-button @(activeTab == "distribute" ? "active" : "")" @onclick="() => SelectTab("distribute")">
                📦 Distribute
            </button>
            <button class="tab-button @(activeTab == "report" ? "active" : "")" @onclick="() => SelectTab("report")">
                📄 Report
            </button>
        </div>

        <!-- Sync Files Tab -->
        <div class="tab-content @(activeTab == "sync" ? "active" : "")">
            <h2 style="margin-top: 0; color: #333;">Sync Files from Host</h2>

            <div class="form-group">
                <label class="form-label">Host Name</label>
                <input type="text" class="form-input" @bind="hostName" placeholder="e.g., MACHINE-01" />
            </div>

            <div class="form-group">
                <label class="form-label">File Path</label>
                <input type="text" class="form-input" @bind="filePath" placeholder="e.g., C:\Program Files\MyApp\config.ini" />
            </div>

            <div class="button-group">
                <button class="btn btn-primary" @onclick="AddFileToSync">+ Add File</button>
                <button class="btn btn-primary" @onclick="SyncSelectedFiles" disabled="@(!filesToSync.Any())">
                    ✓ Sync @filesToSync.Count File(s)
                </button>
                <button class="btn btn-secondary" @onclick="ClearFilesToSync" disabled="@(!filesToSync.Any())">
                    Clear
                </button>
            </div>

            @if (filesToSync.Any())
            {
                <div class="file-list">
                    <h4 style="margin: 0 0 12px 0; color: #333;">Files to Sync (@filesToSync.Count)</h4>
                    @foreach (var file in filesToSync)
                    {
                        <div class="file-item">
                            <span class="file-item-name">📄 @file</span>
                            <button class="file-item-remove" @onclick="() => filesToSync.Remove(file)">Remove</button>
                        </div>
                    }
                </div>
            }

            @if (syncedFiles.Any())
            {
                <div class="alert alert-success">
                    <h4>✓ Sync Completed Successfully</h4>
                    <p>@syncedFiles.Count file(s) synced:</p>
                    <ul style="margin: 8px 0; padding-left: 20px;">
                        @foreach (var file in syncedFiles)
                        {
                            <li><strong>@file.FileName</strong> - @file.LastModifiedUtc.ToString("g")</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(syncError))
            {
                <div class="alert alert-error">
                    <strong>Error:</strong> @syncError
                </div>
            }
        </div>

        <!-- Repository Tab -->
        <div class="tab-content @(activeTab == "repository" ? "active" : "")">
            <h2 style="margin-top: 0; color: #333;">File Repository</h2>

            <div class="button-group" style="margin-bottom: 20px;">
                <button class="btn btn-primary" @onclick="LoadRepository">🔄 Refresh Repository</button>
            </div>

            @if (allTimestamps == null)
            {
                <div style="text-align: center; padding: 40px; color: #999;">
                    <div class="loading" style="margin: 0 auto 16px;"></div>
                    Loading repository...
                </div>
            }
            else if (!allTimestamps.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon">📭</div>
                    <h3>No Files in Repository</h3>
                    <p>Start by syncing files from your host computers</p>
                </div>
            }
            else
            {
                <div style="display: grid; gap: 15px;">
                    @{
                        var groupedByFile = allTimestamps
                            .GroupBy(t => t.FileName, StringComparer.OrdinalIgnoreCase)
                            .OrderBy(g => g.Key)
                            .ToList();
                    }

                    @foreach (var fileGroup in groupedByFile)
                    {
                        var latest = fileGroup.OrderByDescending(t => t.LastModifiedUtc).First();
                        <div style="background: white; border-radius: 6px; padding: 16px; border-left: 4px solid #667eea;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                <h4 style="margin: 0; color: #333;">📄 @fileGroup.Key</h4>
                                <span class="badge badge-success">Latest</span>
                            </div>
                            <table style="width: 100%; font-size: 12px; color: #666;">
                                <tr>
                                    <td><strong>Host:</strong></td>
                                    <td>@latest.HostName</td>
                                    <td style="padding-left: 20px;"><strong>Modified:</strong></td>
                                    <td>@latest.LastModifiedUtc.ToString("g")</td>
                                </tr>
                                <tr>
                                    <td><strong>Size:</strong></td>
                                    <td>@FormatBytes(latest.FileSize)</td>
                                    <td style="padding-left: 20px;"><strong>Hash:</strong></td>
                                    <td><code>@latest.Sha256Hash.Substring(0, Math.Min(16, latest.Sha256Hash.Length))...</code></td>
                                </tr>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Distribute Updates Tab -->
        <div class="tab-content @(activeTab == "distribute" ? "active" : "")">
            <h2 style="margin-top: 0; color: #333;">Distribute Updates</h2>

            <div class="form-group">
                <label class="form-label">Target Host Name</label>
                <input type="text" class="form-input" @bind="targetHostName" placeholder="e.g., MACHINE-02" />
            </div>

            <div class="button-group">
                <button class="btn btn-primary" @onclick="GetDistributionUpdates">🔍 Check Updates</button>
            </div>

            @if (distributionUpdates != null && distributionUpdates.Any())
            {
                <div class="alert alert-info" style="margin-top: 20px;">
                    <h4>📦 @distributionUpdates.Count Files Ready for Distribution</h4>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>From Host</th>
                                <th>Modified</th>
                                <th>Size</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in distributionUpdates)
                            {
                                var file = kvp.Value;
                                <tr>
                                    <td><strong>@file.FileName</strong></td>
                                    <td><span class="badge badge-success">@file.HostName</span></td>
                                    <td>@file.LastModifiedUtc.ToString("g")</td>
                                    <td>@FormatBytes(file.FileSize)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (distributionUpdates != null)
            {
                <div class="alert alert-success" style="margin-top: 20px;">
                    ✓ Host is already up to date with all latest versions
                </div>
            }

            @if (!string.IsNullOrEmpty(distributeError))
            {
                <div class="alert alert-error">
                    <strong>Error:</strong> @distributeError
                </div>
            }
        </div>

        <!-- Report Tab -->
        <div class="tab-content @(activeTab == "report" ? "active" : "")">
            <h2 style="margin-top: 0; color: #333;">Repository Report</h2>

            <div class="button-group">
                <button class="btn btn-primary" @onclick="GenerateReport">📋 Generate Report</button>
                @if (!string.IsNullOrEmpty(reportText))
                {
                    <button class="btn btn-secondary" @onclick="CopyReportToClipboard">📋 Copy to Clipboard</button>
                }
            </div>

            @if (!string.IsNullOrEmpty(reportText))
            {
                <div style="background: #f5f5f5; padding: 20px; border-radius: 6px; margin-top: 20px; border-left: 4px solid #667eea;">
                    <pre style="margin: 0; white-space: pre-wrap; word-wrap: break-word; font-size: 12px; color: #333; font-family: 'Courier New', monospace;">@reportText</pre>
                </div>
            }
            else
            {
                <div class="empty-state" style="margin-top: 30px;">
                    <div class="empty-state-icon">📄</div>
                    <p>Click "Generate Report" to create a repository report</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string hostName = "";
    private string filePath = "";
    private string targetHostName = "";
    private string activeTab = "sync";

    private List<string> filesToSync = new();
    private List<FileTimestampInfo> syncedFiles = new();
    private List<FileTimestampInfo>? allTimestamps;
    private Dictionary<string, FileTimestampInfo>? distributionUpdates;
    private string? syncError;
    private string? distributeError;
    private string reportText = "";

    private void SelectTab(string tab) => activeTab = tab;

    private void AddFileToSync()
    {
        if (!string.IsNullOrEmpty(filePath) && !filesToSync.Contains(filePath))
        {
            filesToSync.Add(filePath);
            filePath = "";
        }
    }

    private void ClearFilesToSync() => filesToSync.Clear();

    private async Task SyncSelectedFiles()
    {
        if (string.IsNullOrEmpty(hostName))
        {
            syncError = "Please enter a host name";
            return;
        }

        try
        {
            syncError = null;
            syncedFiles = await UpdateManager.SyncHostFilesAsync(hostName, filesToSync.ToList());
            filesToSync.Clear();
            await LoadRepository();
        }
        catch (Exception ex)
        {
            syncError = $"Error during sync: {ex.Message}";
            Logger.LogError(ex, "Sync error");
        }
    }

    private async Task LoadRepository()
    {
        allTimestamps = await Repository.GetAllTimestampsAsync();
    }

    private async Task GetDistributionUpdates()
    {
        if (string.IsNullOrEmpty(targetHostName))
        {
            distributeError = "Please enter a target host name";
            return;
        }

        try
        {
            distributeError = null;
            distributionUpdates = await UpdateManager.DistributeLatestFilesAsync(targetHostName);
        }
        catch (Exception ex)
        {
            distributeError = $"Error: {ex.Message}";
            Logger.LogError(ex, "Distribution error");
        }
    }

    private async Task GenerateReport()
    {
        reportText = await Repository.GenerateRepositoryReportAsync();
    }

    private async Task CopyReportToClipboard()
    {
        // Note: This would require JavaScript interop in production
        // For now, showing success feedback
        await Task.CompletedTask;
    }

    private static string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRepository();
    }
}
